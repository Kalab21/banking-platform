# ---------------------------------------------------------------------------
# Banking Platform — frontend environment
# Copy to `.env.local` and adjust. Never commit a real `.env` file.
# Every value here is a local development placeholder.
# ---------------------------------------------------------------------------

# Where the Next.js server reaches the Spring Cloud API Gateway.
# This is read server-side only; the browser never talks to the gateway directly.
# Inside Docker Compose this becomes http://api-gateway:8080
API_GATEWAY_URL=http://localhost:8080
