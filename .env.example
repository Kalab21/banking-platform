# ---------------------------------------------------------------------------
# Banking Platform — local environment for Docker Compose
# Copy to `.env`. Never commit the real `.env`.
# Every value here is for local development with synthetic data.
# ---------------------------------------------------------------------------

# --- PostgreSQL: the one set of local database credentials ---
# Postgres and every service in docker-compose.yml read these. Postgres applies
# them only when its data volume is first created, so changing them later means
# recreating that volume. The same values are the local defaults in each
# service's application.yml, which is what a service run from an IDE uses.
POSTGRES_USER=bankingadmin
POSTGRES_PASSWORD=bankingpass

# --- JWT signing key ---
# Required. Gateway and user-service must use the same 256-bit-or-longer secret.
# Generate one, for example:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-randomly-generated-256-bit-secret

# --- Demo reviewer: synthetic, local-only staff account ---
# user-service creates it at start-up so identity checks and referred credit
# applications can be completed. scripts/seed-demo.sh, e2e-tests.ps1 and the
# live Playwright suites read the same variables.
NORTHBANK_DEMO_STAFF_USERNAME=northbank.reviewer
NORTHBANK_DEMO_STAFF_PASSWORD=ReviewerDemo2026!

# Kafka, Redis and Eureka addresses are set per service in docker-compose.yml,
# and default to localhost in application.yml for IDE runs. Terraform under
# infrastructure/aws takes its settings from its own variables and your AWS
# profile, not from this file.
