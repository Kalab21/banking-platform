# ---------------------------------------------------------------------------
# Banking Platform — example environment configuration
# Copy to `.env` and replace every value. NEVER commit the real `.env`.
# All values below are placeholders, not real credentials.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=bankingadmin
POSTGRES_PASSWORD=change-me-local-dev-only
SPRING_DATASOURCE_USERNAME=bankingadmin
SPRING_DATASOURCE_PASSWORD=change-me-local-dev-only

# --- JWT signing key ---
# Must be at least 256 bits (32+ chars) for HS256. Generate a new one, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-randomly-generated-256-bit-secret
JWT_EXPIRATION=86400000

# --- Kafka ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- Redis ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# --- Service discovery ---
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# --- AWS deployment (infrastructure/aws, Terraform) ---
# Supply via your own AWS profile / SSO, not by committing keys.
AWS_REGION=us-east-1
